---
// Arrows are text set in Geist (§2.4), consistent with his → chains; never an icon.
// Decorative by default (the link text carries the meaning). Magnetic motion is on the parent [data-magnet].
interface Props {
  dir?: 'right' | 'up-right' | 'down' | 'left' | 'up';
  class?: string;
}

const { dir = 'right', class: cls } = Astro.props;
const GLYPH = { right: '→', 'up-right': '↗', down: '↓', left: '←', up: '↑' } as const;
---
<span class:list={['arrow', `arrow--${dir}`, cls]} aria-hidden="true" data-arrow>{GLYPH[dir]}</span>

<style>
  .arrow {
    display: inline-block;
    font-family: var(--font-display, sans-serif), var(--ff-body);
    font-weight: 400;
    font-variation-settings: normal;
    line-height: 1;
    transition: transform var(--d-s) var(--ease-rise);
  }
  :global(a:is(:hover, :focus-visible)) > .arrow--right,
  :global(a:is(:hover, :focus-visible)) .arrow--right {
    transform: translateX(0.18em);
  }
  :global(a:is(:hover, :focus-visible)) .arrow--up-right {
    transform: translate(0.12em, -0.12em);
  }
  :global(html[data-tier='static']) .arrow,
  :global(html[data-motion='reduced']) .arrow {
    transition: none;
  }
</style>
