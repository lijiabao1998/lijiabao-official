---
// <Status code="review" />  (§2.4) — a 16px glyph (aria-hidden) always followed by the localized word.
// Status is shape + text only; no hue. Failures carry the same size and weight as passes (site law 5).
import { localeOf, ts } from '../chrome/i18n';

import type { StatusCode } from '@data/labs';

interface Props {
  code: StatusCode;
  /** render the word visually hidden (glyph-only layouts that repeat the word elsewhere) */
  quiet?: boolean;
  as?: 'span' | 'p' | 'li';
  class?: string;
}

const { code, quiet = false, as: Tag = 'span', class: cls } = Astro.props;
const locale = localeOf(Astro);
---
<Tag class:list={['status', cls]} data-status={code}>
  <svg class="status-g" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
    {code === 'open' && <circle cx="8" cy="8" r="5.25" />}
    {
      code === 'review' && (
        <Fragment>
          <circle cx="8" cy="8" r="5.25" />
          <path class="fill" d="M8 2.75a5.25 5.25 0 0 1 0 10.5z" />
        </Fragment>
      )
    }
    {code === 'merged' && <circle class="fill" cx="8" cy="8" r="6" />}
    {
      code === 'none' && (
        <Fragment>
          <circle cx="8" cy="8" r="5.25" />
          <path d="M5.5 8h5" stroke-width="1" />
        </Fragment>
      )
    }
    {code === 'fail' && <path d="M4 4l8 8M12 4l-8 8" />}
    {
      code === 'withdrawn' && (
        <Fragment>
          <circle cx="8" cy="8" r="5.25" />
          <path d="M4.3 11.7l7.4-7.4" />
        </Fragment>
      )
    }
    {
      code === 'notclaimed' && (
        <Fragment>
          <circle cx="8" cy="8" r="4.25" />
          <path d="M2 14L14 2" />
        </Fragment>
      )
    }
    {code === 'paused' && <path d="M5.75 3.5v9M10.25 3.5v9" />}
    {
      code === 'active' && (
        <Fragment>
          <circle class="ring" cx="8" cy="8" r="6.25" stroke-width="1" />
          <circle class="fill core" cx="8" cy="8" r="3.5" />
        </Fragment>
      )
    }
  </svg>
  <span class:list={['status-w', { 'sr-only': quiet }]}>{ts(`status.${code}`, locale)}</span>
</Tag>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--ff-mono);
    font-size: var(--fs-mono);
    font-weight: var(--w-mono);
    letter-spacing: 0.04em;
    line-height: 1.3;
    color: var(--fg);
    white-space: nowrap;
  }
  .status-g {
    flex: none;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    overflow: visible;
  }
  .status-g :global(.fill) {
    fill: currentColor;
    stroke: none;
  }
  /* ACTIVE: the one status that is live — an amber core with a 2.4s breathing ring */
  [data-status='active'] .status-g :global(.core) {
    fill: var(--glim);
  }
  [data-status='active'] .status-g :global(.ring) {
    stroke: var(--glim);
    transform-origin: 8px 8px;
    transform-box: view-box;
    animation: lj-breathe 2.4s ease-in-out infinite;
  }
  :global(html[data-motion='reduced']) [data-status='active'] .status-g :global(.ring) {
    animation: none;
    opacity: 0.5;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-status='active'] .status-g :global(.ring) {
      animation: none;
      opacity: 0.5;
    }
  }
</style>
