---
// header#top (§3): NOT persisted — it carries locale strings and aria-current, so ClientRouter swaps it
// (transition:animate="none" keeps it out of the root cross-fade). Order = Tab order (§5.4):
// wordmark → nav → HUD → language → (mobile) menu button.
// 文章 / 觀點 (Articles / Views) join the nav only for a section with ≥ 1 published post in this locale. With them
// the inline nav no longer fits below 1024px, so there (.hdr--more) the menu button takes over from 640px too.
import Hud from './Hud.astro';
import LangSwitch from './LangSwitch.astro';
import Menu from './Menu.astro';
import { isContent, localeOf, localePath, ts, type Page } from './i18n';
import { navSections } from '@lib/content';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const locale = localeOf(Astro);
const home = localePath(locale, '/');
const sections = ['work', 'method', 'vision', 'about', 'contact'] as const;
const content = await navSections(locale);
const here = isContent(page) && page.kind === 'section' ? page.section : null;
---
<header id="top" class:list={['hdr', { 'hdr--more': content.length > 0 }]} transition:animate="none" data-header>
  <div class="hdr-bar wrap">
    <a class="wordmark" href={home} aria-current={page === 'home' ? 'page' : undefined} data-menu-inert>
      <span class="wordmark-name">{ts('site.name', locale)}</span><span class="wordmark-dot" aria-hidden="true"
      ></span>
    </a>

    <nav class="hdr-nav" aria-label={ts('a11y.nav', locale)} data-menu-inert>
      <ul role="list">
        {
          sections.map((id) => (
            <li>
              <a class="link hdr-link" href={`${home}#${id}`}>
                {ts(`nav.${id}`, locale)}
              </a>
            </li>
          ))
        }
        {
          content.map((c, i) => (
            <li class:list={['hdr-sec', { 'is-first': i === 0 }]}>
              <a
                class="link hdr-link"
                href={localePath(locale, c.path)}
                aria-current={here === c.section ? 'page' : undefined}
                data-nav-section={c.section}
              >
                {ts(`nav.${c.section}`, locale)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hdr-end">
      <span class="hdr-slot" data-menu-inert><Hud id="hud" class="hud--bar" /></span>
      <span class="hdr-slot" data-menu-inert><LangSwitch page={page} /></span>
      <Menu page={page} />
    </div>
  </div>
  <span class="hdr-progress" aria-hidden="true"></span>
</header>

<script>
  // Header state (§5.3): the bar is always opaque --bg; after 24px of scroll its bottom hairline fades in.
  // A passive listener that writes only when the state flips: reading scrollY never forces layout, and no rAF,
  // so the state is right even where frames are throttled (hidden windows). The header is swapped by the
  // ClientRouter (not persisted), so the element is looked up again on every page load.
  let header: HTMLElement | null = document.querySelector<HTMLElement>('[data-header]');
  const update = () => {
    if (!header) return;
    const scrolled = window.scrollY > 24;
    if (header.hasAttribute('data-scrolled') !== scrolled) header.toggleAttribute('data-scrolled', scrolled);
  };
  window.addEventListener('scroll', update, { passive: true });
  document.addEventListener('astro:page-load', () => {
    header = document.querySelector<HTMLElement>('[data-header]');
    update();
  });
  update();

  // Navigation progress (§5.5): only if fetching takes more than 300ms; no fake percentage.
  let timer = 0;
  const root = document.documentElement;
  document.addEventListener('astro:before-preparation', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => root.setAttribute('data-loading', ''), 300);
  });
  const done = () => {
    window.clearTimeout(timer);
    root.removeAttribute('data-loading');
  };
  document.addEventListener('astro:after-preparation', done);
  document.addEventListener('astro:page-load', done);
</script>

<style>
  /* Opaque, always: nothing reads through behind the wordmark (§2.5: no blur, no veil gradient). The canvas
     draws under it like under any other --bg surface. */
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    height: var(--header-h);
    background: var(--bg);
  }
  /* the bottom hairline appears once the page has scrolled (data-scrolled, set by the script above) */
  .hdr::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--line);
    opacity: 0;
    transition: opacity var(--d-s) var(--ease-rise);
  }
  .hdr[data-scrolled]::after {
    opacity: 1;
  }
  /* no JS: a scroll-driven fade where the browser has scroll timelines; otherwise the hairline simply stays on */
  :global(html:not([data-js])) .hdr::after {
    opacity: 1;
  }
  @supports (animation-timeline: scroll()) {
    :global(html:not([data-js])) .hdr::after {
      opacity: 0;
      /* longhands only: the minifier would fold a shorthand + timeline into one `animation` value that
         browsers reject */
      animation-name: lj-hdr-line;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
      animation-range: 0 24px;
    }
  }
  @keyframes lj-hdr-line {
    to {
      opacity: 1;
    }
  }
  :global(html[data-menu-open]) .hdr {
    background: var(--bg-2);
  }
  @media (forced-colors: active) {
    .hdr {
      background: Canvas;
    }
    .hdr::after {
      background: CanvasText;
    }
  }

  .hdr-bar {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--s-6);
  }

  .wordmark {
    --w-rest: 600;
    display: inline-flex;
    align-items: baseline;
    min-height: var(--hit);
    padding-block: 10px;
    font-family: var(--ff-display);
    font-size: 1.125rem;
    font-weight: var(--w-rest);
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--fg);
    white-space: nowrap;
  }
  .wordmark:lang(en) {
    --w-rest: 560;
    letter-spacing: -0.01em;
  }
  .wordmark-dot {
    width: 0.3em;
    height: 0.3em;
    margin-inline-start: 0.12em;
    border-radius: 50%;
    background: var(--glim);
    align-self: baseline;
  }

  .hdr-nav ul {
    display: flex;
    gap: var(--s-5);
    list-style: none;
    padding: 0;
  }
  .hdr-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-min);
    font-size: var(--fs-small);
    color: var(--fg-2);
    transition:
      color var(--d-s) var(--ease-rise),
      background-size var(--d-s) var(--ease-rise);
  }
  .hdr-link:is(:hover, :focus-visible),
  .hdr-link[aria-current='page'] {
    color: var(--fg);
  }
  /* the content sections sit after a hairline: they are pages, the links before them are home anchors */
  .hdr-sec.is-first {
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }
  .hdr-sec.is-first::before {
    content: '';
    width: 1px;
    height: 1em;
    background: var(--line-ui);
  }

  .hdr-end {
    margin-inline-start: auto;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-2);
  }
  .hdr-slot {
    display: contents;
  }

  @media (max-width: 639.98px), (pointer: coarse) {
    .hdr-nav,
    .hdr-end :global(.hud--bar) {
      display: none;
    }
  }
  @media (min-width: 640px) and (pointer: fine) {
    .hdr-end :global(.hud--menu) {
      display: none;
    }
  }
  @media (min-width: 640px) and (max-width: 1023.98px) and (pointer: fine) {
    .hdr--more .hdr-nav {
      display: none;
    }
  }

  /* §5.5 navigation progress: a 1px amber segment scanning left → right under the header */
  .hdr-progress {
    position: absolute;
    inset: auto 0 -1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }
  .hdr-progress::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--glim);
    transform: translateX(-100%) scaleX(0.3);
    transform-origin: 0 50%;
  }
  :global(html[data-loading]) .hdr-progress {
    opacity: 1;
  }
  :global(html[data-loading]) .hdr-progress::before {
    animation: lj-progress 1.1s var(--ease-scan) infinite;
  }
</style>
