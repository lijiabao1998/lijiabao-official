---
// Three tier cards in #vision (§3, §7): the same tiers as the footer's fieldset#tier, explained, each with its
// first-view byte cap (budgets.ts, the numbers CI enforces) and a button that calls prefs.setTier(t, 'user').
// Never imports the engine. Which card is current comes from <html data-tier> in CSS, so the first paint is right
// (no-JS = static, which is exactly what the static card then says); the script only mirrors aria-pressed.
// With no JS the buttons are hidden (.js-only); the cards stay as plain, complete text.
import { firstViewCap } from '@data/budgets';
import { localeOf, tpl, ts } from '../chrome/i18n';

const locale = localeOf(Astro);
const tiers = ['full', 'lite', 'static'] as const;
const use = ts('vision.tiers.use', locale);
const current = ts('vision.tiers.current', locale);
---
<div class="tc" data-tier-cards data-i18n-changed={tpl('a11y.tier.changed', locale, ['tier'])}>
  <h3 class="tc-title t-label" data-rise>{ts('vision.tiers.title', locale)}</h3>
  <ul class="tc-list" role="list">
    {
      tiers.map((t) => (
        <li class="tc-card" data-tc={t} data-rise>
          <span class="tc-ind" aria-hidden="true" />
          <div class="tc-head">
            <h4 id={`tc-${t}-name`} class="tc-name">
              {ts(`tier.${t}`, locale)}
            </h4>
            <p class="tc-now t-label" data-parity-ignore>
              <span class="tc-now-dot" aria-hidden="true" />
              {current}
            </p>
          </div>
          <p class="tc-desc">{ts(`tier.${t}.desc`, locale)}</p>
          <p class="tc-cap t-label">{ts('tier.cap', locale, { kb: firstViewCap(locale, t) })}</p>
          <button
            type="button"
            class="tc-btn js-only"
            data-tier-use={t}
            data-label={ts(`tier.${t}`, locale)}
            aria-pressed="false"
            aria-labelledby={`tc-${t}-use tc-${t}-name`}
            data-parity-ignore
          >
            <span class="tc-btn-glyph" aria-hidden="true" />
            <span id={`tc-${t}-use`}>{use}</span>
          </button>
        </li>
      ))
    }
  </ul>
  <p class="tc-reduced t-small c-fg-2">{ts('tier.reduced', locale)}</p>
  <p class="sr-only" aria-live="polite" data-tc-live></p>
</div>

<script>
  import { on } from '@lib/events';
  import { getTier, isTier, setTier } from '@lib/prefs';

  const root = document.documentElement;
  let pending = '';

  /** aria-pressed mirrors <html data-tier> (the visual state is pure CSS). */
  function sync() {
    const tier = getTier();
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-tier-use]')) {
      b.setAttribute('aria-pressed', String(b.dataset.tierUse === tier));
    }
  }

  function bind() {
    const box = document.querySelector<HTMLElement>('[data-tier-cards]');
    if (!box || box.dataset.bound) return sync();
    box.dataset.bound = '';
    box.addEventListener('click', (e) => {
      const b = (e.target as Element | null)?.closest<HTMLButtonElement>('[data-tier-use]');
      const t = b?.dataset.tierUse;
      if (!b || !isTier(t)) return;
      pending = b.dataset.label ?? t;
      setTier(t, 'user');
    });
    sync();
  }

  on('lj:tier', (d) => {
    sync();
    if (!d.reason || !pending) return;
    // announce only switches made here (the footer fieldset announces its own)
    const box = document.querySelector<HTMLElement>('[data-tier-cards]');
    const live = box?.querySelector<HTMLElement>('[data-tc-live]');
    if (box && live) live.textContent = (box.dataset.i18nChanged ?? '').replace('{tier}', pending);
    pending = '';
  });
  new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['data-tier'] });
  document.addEventListener('astro:page-load', bind);
</script>

<style>
  .tc-title {
    color: var(--fg-3);
    margin-bottom: var(--s-6);
  }
  .tc-list {
    display: grid;
    gap: var(--s-7);
    list-style: none;
    padding: 0;
  }
  @media (min-width: 900px) {
    .tc-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--gap);
    }
  }

  .tc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .tc-card {
      padding-right: var(--s-6);
    }
  }
  /* the current tier: a 2px glimmer hairline scans in from the left and leaves to the right (law 2) */
  .tc-ind {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--glim);
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform var(--d-m) var(--ease-exit);
  }
  :global(html[data-tier='full']) [data-tc='full'] .tc-ind,
  :global(html[data-tier='lite']) [data-tc='lite'] .tc-ind,
  :global(html[data-tier='static']) [data-tc='static'] .tc-ind {
    transform: scaleX(1);
    transform-origin: 0 50%;
    transition: transform var(--d-l) var(--ease-scan) var(--d-xs);
  }

  .tc-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2) var(--s-4);
  }
  .tc-name {
    font-family: var(--ff-body);
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .tc-name:lang(zh) {
    letter-spacing: 0.04em;
  }
  .tc-now {
    display: none;
    align-items: center;
    gap: 8px;
    color: var(--fg);
  }
  .tc-now-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--glim);
  }
  :global(html[data-tier='full']) [data-tc='full'] .tc-now,
  :global(html[data-tier='lite']) [data-tc='lite'] .tc-now,
  :global(html[data-tier='static']) [data-tc='static'] .tc-now {
    display: inline-flex;
  }
  .tc-desc {
    max-width: 34ch;
    color: var(--fg-2);
  }
  .tc-desc:lang(zh) {
    max-width: 21em;
  }
  .tc-cap {
    color: var(--fg-3);
    text-transform: none;
  }

  .tc-btn {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 10px;
    min-height: var(--hit);
    margin-top: auto;
    padding: 0 18px 0 14px;
    border: 1px solid var(--line-ui);
    border-radius: 999px;
    font-family: var(--ff-mono);
    font-size: var(--fs-mono);
    font-weight: var(--w-mono);
    letter-spacing: 0.06em;
    color: var(--fg);
    transition:
      border-color var(--d-s) var(--ease-rise),
      color var(--d-s) var(--ease-rise);
  }
  .tc-btn:lang(en) {
    text-transform: uppercase;
  }
  .tc-btn:is(:hover, :focus-visible) {
    border-color: var(--fg-2);
  }
  .tc-btn-glyph {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px currentColor;
    transition: background-color var(--d-s) var(--ease-rise);
  }
  /* pressed = the tier in use: the ring fills, the border lifts to --fg (amber stays on the hairline) */
  :global(html[data-tier='full']) [data-tc='full'] .tc-btn,
  :global(html[data-tier='lite']) [data-tc='lite'] .tc-btn,
  :global(html[data-tier='static']) [data-tc='static'] .tc-btn {
    border-color: var(--fg);
  }
  :global(html[data-tier='full']) [data-tc='full'] .tc-btn-glyph,
  :global(html[data-tier='lite']) [data-tc='lite'] .tc-btn-glyph,
  :global(html[data-tier='static']) [data-tc='static'] .tc-btn-glyph {
    background: var(--glim);
    box-shadow: none;
  }

  .tc-reduced {
    display: none;
    margin-top: var(--s-6);
  }
  :global(html[data-motion='reduced']) .tc-reduced {
    display: block;
  }

  @media (forced-colors: active) {
    .tc-ind,
    .tc-now-dot {
      background: Highlight;
    }
    .tc-btn {
      border-color: ButtonText;
    }
  }
</style>
