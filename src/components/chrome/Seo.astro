---
// <title>, description, canonical, hreflang (zh-Hant / en / x-default → zh), Open Graph + Twitter card.
// OG cards are scripts/og.mjs output in src/assets/og/{zh,en}-{home,gt,fr}.png (1200×630), imported here so Astro
// emits them as /_astro/<name>.<hash>.png: a regenerated card is a new URL, which X (it caches card images by
// URL) refetches, and no fixed path can go stale.
//
// Content pages (/articles/, /views/, their posts) bring their own head (ContentPage): hreflang only when the page
// exists in both locales, og:type article with article:* times for posts, noindex (and no Markdown alternate) for
// an empty section, the post card or else the section card (chrome/og.ts), and the RSS feed of the section.
import type { ImageMetadata } from 'astro';
import type { Locale } from '@i18n/types';
import { PAGE_PATH, isContent, localePath, localeTag, ts, type Page } from './i18n';
import { isoDay } from '@lib/posts';

interface Props {
  locale: Locale;
  page: Page;
}

const OG_CARDS = import.meta.glob<ImageMetadata>('../../assets/og/*.png', { eager: true, import: 'default' });

const { locale, page } = Astro.props;
const site = Astro.site ?? new URL('https://lijiabao.dev');
const abs = (p: string) => new URL(p, site).href;
const siteName = ts('site.name', locale);

let title: string;
let description: string;
let ogImage: string;
let ogAlt: string;
let canonical: string | null;
let zhUrl: string | null;
let enUrl: string | null;
let noindex: boolean;
let author = siteName;
let feed: string | null = null;
let feedTitle = '';

if (isContent(page)) {
  title = page.title;
  description = page.description;
  ogImage = abs(page.ogImage.src);
  ogAlt = page.ogAlt;
  const own = page.paths[locale];
  canonical = own ? abs(localePath(locale, own)) : null;
  const paired = page.paths['zh-Hant'] !== undefined && page.paths.en !== undefined;
  zhUrl = paired ? abs(localePath('zh-Hant', page.paths['zh-Hant'] as string)) : null;
  enUrl = paired ? abs(localePath('en', page.paths.en as string)) : null;
  noindex = page.noindex;
  author = page.author;
  feed = abs(localePath(locale, page.feed));
  feedTitle = ts(`meta.${page.section}.title`, locale);
} else {
  title = ts(`meta.${page}.title`, locale);
  description = page === 'nf' ? ts('nf.body', locale) : ts(`meta.${page}.desc`, locale);
  const ogPage = page === 'nf' ? 'home' : page;
  ogAlt = ts(`meta.og.${ogPage}`, locale);
  const ogCard = OG_CARDS[`../../assets/og/${localeTag(locale)}-${ogPage}.png`];
  if (!ogCard) throw new Error(`[Seo] missing OG card ${localeTag(locale)}-${ogPage}.png — run \`npm run og\``);
  ogImage = abs(ogCard.src);
  const path = PAGE_PATH[page];
  canonical = path ? abs(localePath(locale, path)) : null;
  zhUrl = path ? abs(localePath('zh-Hant', path)) : null;
  enUrl = path ? abs(localePath('en', path)) : null;
  noindex = page === 'nf';
}
const post = isContent(page) && page.kind === 'post' ? page : null;
---
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
{canonical && <link rel="canonical" href={canonical} />}
{zhUrl && <link rel="alternate" hreflang="zh-Hant" href={zhUrl} />}
{enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
{zhUrl && <link rel="alternate" hreflang="x-default" href={zhUrl} />}
{canonical && !noindex && <link rel="alternate" type="text/markdown" href={`${canonical}index.md`} />}
{feed && <link rel="alternate" type="application/rss+xml" title={feedTitle} href={feed} />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap.xml" />
<meta name="theme-color" content="#0B0B0C" />
<meta name="color-scheme" content="dark" />
<meta name="format-detection" content="telephone=no" />
<meta property="og:type" content={post ? 'article' : page === 'home' ? 'profile' : 'website'} />
<meta property="og:site_name" content="lijiabao.dev" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_TW'} />
{(!isContent(page) || enUrl) && <meta property="og:locale:alternate" content={locale === 'en' ? 'zh_TW' : 'en_US'} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
{post?.published && <meta property="article:published_time" content={isoDay(post.published)} />}
{post?.modified && <meta property="article:modified_time" content={isoDay(post.modified)} />}
{post?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
{page === 'home' && <meta property="profile:username" content={ts('site.handle', locale)} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogAlt} />
<meta name="author" content={author} />
