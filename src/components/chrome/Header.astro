---
// header#top (§3): NOT persisted — it carries locale strings and aria-current, so ClientRouter swaps it
// (transition:animate="none" keeps it out of the root cross-fade). Order = Tab order (§5.4):
// wordmark → nav → HUD → language → (mobile) menu button.
import Hud from './Hud.astro';
import LangSwitch from './LangSwitch.astro';
import Menu from './Menu.astro';
import { localeOf, localePath, ts, type PageId } from './i18n';

interface Props {
  page: PageId;
}

const { page } = Astro.props;
const locale = localeOf(Astro);
const home = localePath(locale, '/');
const sections = ['work', 'method', 'vision', 'about', 'contact'] as const;
---
<header id="top" class="hdr" transition:animate="none" data-header>
  <div class="hdr-bar wrap">
    <a class="wordmark" href={home} aria-current={page === 'home' ? 'page' : undefined} data-menu-inert>
      <span class="wordmark-name">{ts('site.name', locale)}</span><span class="wordmark-dot" aria-hidden="true"
      ></span>
    </a>

    <nav class="hdr-nav" aria-label={ts('a11y.nav', locale)} data-menu-inert>
      <ul role="list">
        {
          sections.map((id) => (
            <li>
              <a class="link hdr-link" href={`${home}#${id}`}>
                {ts(`nav.${id}`, locale)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hdr-end">
      <span class="hdr-slot" data-menu-inert><Hud id="hud" class="hud--bar" /></span>
      <span class="hdr-slot" data-menu-inert><LangSwitch page={page} /></span>
      <Menu page={page} />
    </div>
  </div>
  <span class="hdr-progress" aria-hidden="true"></span>
</header>

<script>
  // Header state (§5.3): after 24px of scroll, a bottom hairline and a --bg veil fade in.
  let header: HTMLElement | null = null;
  let queued = false;
  const update = () => {
    queued = false;
    header?.toggleAttribute('data-scrolled', window.scrollY > 24);
  };
  const onScroll = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(update);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('astro:page-load', () => {
    header = document.querySelector<HTMLElement>('[data-header]');
    update();
  });

  // Navigation progress (§5.5): only if fetching takes more than 300ms; no fake percentage.
  let timer = 0;
  const root = document.documentElement;
  document.addEventListener('astro:before-preparation', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => root.setAttribute('data-loading', ''), 300);
  });
  const done = () => {
    window.clearTimeout(timer);
    root.removeAttribute('data-loading');
  };
  document.addEventListener('astro:after-preparation', done);
  document.addEventListener('astro:page-load', done);
</script>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    height: var(--header-h);
    background: transparent;
    transition: background-color var(--d-s) var(--ease-rise);
  }
  .hdr::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--line);
    opacity: 0;
    transition: opacity var(--d-s) var(--ease-rise);
  }
  .hdr[data-scrolled] {
    background: var(--bg-veil);
  }
  .hdr[data-scrolled]::after {
    opacity: 1;
  }
  :global(html[data-menu-open]) .hdr {
    background: var(--bg-2);
  }

  .hdr-bar {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--s-6);
  }

  .wordmark {
    --w-rest: 600;
    display: inline-flex;
    align-items: baseline;
    min-height: var(--hit);
    padding-block: 10px;
    font-family: var(--ff-display);
    font-size: 1.125rem;
    font-weight: var(--w-rest);
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--fg);
    white-space: nowrap;
  }
  .wordmark:lang(en) {
    --w-rest: 560;
    letter-spacing: -0.01em;
  }
  .wordmark-dot {
    width: 0.3em;
    height: 0.3em;
    margin-inline-start: 0.12em;
    border-radius: 50%;
    background: var(--glim);
    align-self: baseline;
  }

  .hdr-nav ul {
    display: flex;
    gap: var(--s-5);
    list-style: none;
    padding: 0;
  }
  .hdr-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-min);
    font-size: var(--fs-small);
    color: var(--fg-2);
    transition:
      color var(--d-s) var(--ease-rise),
      background-size var(--d-s) var(--ease-rise);
  }
  .hdr-link:is(:hover, :focus-visible) {
    color: var(--fg);
  }

  .hdr-end {
    margin-inline-start: auto;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-2);
  }
  .hdr-slot {
    display: contents;
  }

  @media (max-width: 639.98px), (pointer: coarse) {
    .hdr-nav,
    .hdr-end :global(.hud--bar) {
      display: none;
    }
  }
  @media (min-width: 640px) and (pointer: fine) {
    .hdr-end :global(.hud--menu) {
      display: none;
    }
  }

  /* §5.5 navigation progress: a 1px amber segment scanning left → right under the header */
  .hdr-progress {
    position: absolute;
    inset: auto 0 -1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }
  .hdr-progress::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--glim);
    transform: translateX(-100%) scaleX(0.3);
    transform-origin: 0 50%;
  }
  :global(html[data-loading]) .hdr-progress {
    opacity: 1;
  }
  :global(html[data-loading]) .hdr-progress::before {
    animation: lj-progress 1.1s var(--ease-scan) infinite;
  }
</style>
