---
// #about (owner decision 2026-11-18: an introduction): the dot portrait on the left (weight sits on the left), and
// beside it, in order: what he does on the two projects → the account facts → 信念 (the owner's own line, which
// was the hero line until 2026-11-18, then his two X-bio lines, with English glosses on /en/).
// Every line is his own or a plain fact. (The Hebrew line and the signature were removed by the owner, 2026-11-18.)
// The text column rises through the generic [data-rise] reveal; the portrait's assembly is motion/sections/about.ts.
import Section from '@ui/Section.astro';
import T from '@ui/T.astro';
import Portrait from './Portrait.astro';
import type { Key } from '@i18n/types';
import { localeOf, ts } from '../chrome/i18n';

const locale = localeOf(Astro);
const lines = [1, 2].map((i) => ({ line: `about.line${i}` as Key, gloss: `about.line${i}.gloss` as Key }));
---
<Section id="about" motion="about" label="about.label" labelAs="h2">
  <div class="ab">
    <div class="ab-fig">
      <Portrait />
    </div>

    <div class="ab-text">
      <T k="about.role" as="p" class="ab-role" data-rise />
      <div class="ab-facts" data-rise>
        <T k="about.repos" as="p" />
        <T k="about.older" as="p" />
      </div>

      <div class="ab-beliefs">
        <h3 class="ab-sub t-label" data-rise>{ts('about.belief.label', locale)}</h3>
        <T k="about.belief" as="p" class="ab-belief" data-rise />
        <ul class="ab-lines" role="list">
          {
            lines.map((l) => (
              <li class="ab-line" data-rise>
                <T k={l.line} as="p" class="ab-motto" />
                <T k={l.gloss} as="p" class="ab-gloss" />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</Section>

<style>
  .ab {
    display: grid;
    gap: var(--s-8);
  }
  @media (min-width: 1024px) {
    .ab {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      align-items: start;
    }
    .ab-fig {
      grid-column: 1 / span 6;
    }
    .ab-text {
      grid-column: 8 / span 5;
      padding-top: var(--s-9);
    }
  }

  .ab-text {
    display: flex;
    flex-direction: column;
    gap: var(--s-7);
    min-width: 0;
  }
  .ab-text :global(.ab-role) {
    font-size: var(--fs-lede);
    line-height: 1.45;
    color: var(--fg);
    max-width: 26em;
  }
  .ab-text :global(.ab-role:lang(zh)) {
    line-height: 1.75;
  }
  .ab-facts {
    display: grid;
    gap: var(--s-2);
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--fg-2);
  }

  /* ---- 信念: his own line first (display face: its glyphs are in the subset), then the two X-bio lines ---- */
  .ab-sub {
    color: var(--fg-3);
    margin-bottom: var(--s-4);
  }
  .ab-text :global(.ab-belief) {
    font-family: var(--ff-display);
    font-size: var(--fs-h3);
    font-weight: 560;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--fg);
    text-wrap: balance;
  }
  .ab-text :global(.ab-belief:lang(zh)) {
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: 0.04em;
  }
  .ab-lines {
    list-style: none;
    margin-top: var(--s-5);
    padding: 0;
    display: grid;
    gap: var(--s-4);
  }
  .ab-line {
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .ab-text :global(.ab-motto) {
    font-size: var(--fs-body);
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--fg-2);
  }
  .ab-text :global(.ab-gloss) {
    margin-top: var(--s-2);
    font-size: var(--fs-small);
    color: var(--fg-3);
  }
</style>
