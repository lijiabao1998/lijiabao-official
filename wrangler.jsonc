{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static assets only: no `main`, no bindings. Cloudflare Workers Builds runs `npm run build`
  // (prebuild -> astro build -> postbuild headers) and then `npx wrangler deploy`.
  "name": "lijiabao-dev",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "lijiabao.dev", "custom_domain": true }
  ]
}
