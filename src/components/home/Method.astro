---
// #method (owner decision 2026-11-18: how the work is done, stated plainly): one round of work as his → chain
// (5 steps, each → a drawn hairline); the writers line (anonymous; the named variant renders only when
// features.vendorNames is on); the "undone" rule with its citation; and the three verification rules, as a plain
// list with their source (they were the pinned #not statements until 2026-11-18).
// - The chain is an <ol>: order is in the markup; the arrows are aria-hidden hairlines. No-JS / static /
//   reduced motion show every arrow drawn and every step lit.
// Motion: motion/sections/method.ts (chain scrub); everything else rises through the generic [data-rise] reveal.
import Section from '@ui/Section.astro';
import T from '@ui/T.astro';
import { links } from '@data/links';
import { localeOf, tl, ts } from '../chrome/i18n';

const locale = localeOf(Astro);
const steps = tl('method.chain', locale);
const rules = tl('method.rules', locale);
const ext = ts('a11y.external', locale);
---
<Section id="method" motion="method" label="method.label" labelAs="h2">
  <div class="chain-block">
    <T k="method.chain.title" as="h3" class="chain-title t-label" id="method-chain-title" data-rise />
    <ol class="chain" aria-labelledby="method-chain-title" data-chain>
      {
        steps.map((step, i) => (
          <li class="chain-step" data-chain-step>
            {i > 0 && (
              <span class="chain-arr" aria-hidden="true">
                <span class="chain-line" data-chain-line />
                <svg class="chain-head" viewBox="0 0 8 12" width="8" height="12" focusable="false">
                  <path d="M1.5 1.5 6.5 6l-5 4.5" pathLength="1" data-chain-head />
                </svg>
              </span>
            )}
            <span class="chain-term" data-chain-term>{step}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="m-foot">
    <div class="m-writers">
      <T k="method.writers" as="p" class="m-writers-text" data-rise />
      <T k="method.writers.named" as="p" class="m-writers-text m-writers-named" data-rise />
    </div>
    <figure class="m-undone" data-rise>
      <blockquote>
        <T k="method.undone" as="p" class="m-undone-text" />
      </blockquote>
      <figcaption class="m-undone-cite t-label">
        <a class="link" href={links.docs.labAutorun}><T k="method.undone.cite" /><span class="sr-only">{ext}</span></a>
      </figcaption>
    </figure>
  </div>

  <div class="m-rules">
    <T k="method.rules.title" as="h3" class="m-rules-title t-label" id="method-rules-title" data-rise />
    <ul class="m-rules-list" role="list" aria-labelledby="method-rules-title">
      {rules.map((r) => <li data-rise>{r}</li>)}
    </ul>
    <p class="m-rules-cite t-label" data-rise>
      <a class="link" href={links.docs.csReadme}><T k="method.rules.cite" /><span class="sr-only">{ext}</span></a>
    </p>
  </div>
</Section>

<style>
  /* ---- the → chain: a sentence of five steps, hairline arrows between them -------------------------- */
  /* the chain opens the section, right under its label */
  .chain-title {
    margin-bottom: var(--s-5);
    color: var(--fg-3);
  }
  .chain {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    row-gap: 0.35em;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--ff-body);
    font-size: var(--fs-h3);
    font-weight: 450;
    line-height: 1.45;
    letter-spacing: 0.02em;
    color: var(--fg);
  }
  .chain:lang(en) {
    letter-spacing: -0.005em;
    line-height: 1.3;
  }
  .chain-step {
    display: flex;
    align-items: flex-start;
    min-width: 0;
  }
  .chain-term {
    min-width: 0;
  }
  /* one arrow = a 1px line drawn from the left + a chevron drawn when the line lands; it sits on the
     first line of the step it leads into */
  .chain-arr {
    flex: none;
    display: flex;
    align-items: center;
    width: 2.6em;
    height: 1.45em;
    height: 1lh;
    margin-inline: 0.45em 0.55em;
    color: var(--fg-3);
  }
  .chain-line {
    flex: 1;
    height: 1px;
    background: currentColor;
    transform-origin: 0 50%;
  }
  .chain-head {
    flex: none;
    width: 8px;
    height: 12px;
    margin-left: -6.5px;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .chain-head path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  /* < 640: a vertical sequence. One step per line; each arrow is a short lead in a column of its own (still
     drawn left → right), and every step's text starts on one edge, wrapped lines included. */
  @media (max-width: 639.98px) {
    .chain {
      --lead: 1.75em;
      --lead-gap: 0.5em;
      flex-direction: column;
      flex-wrap: nowrap;
      row-gap: var(--s-2);
    }
    .chain-step {
      width: 100%;
    }
    .chain-step:first-child {
      padding-inline-start: calc(var(--lead) + var(--lead-gap));
    }
    .chain-arr {
      width: var(--lead);
      margin-inline: 0 var(--lead-gap);
    }
  }

  /* ---- writers + the undone rule -------------------------------------------------------------------------- */
  .m-foot {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: var(--s-7);
    margin-top: var(--s-8);
  }
  @media (min-width: 640px) {
    .m-foot {
      row-gap: var(--s-8);
      margin-top: var(--s-9);
    }
  }
  @media (min-width: 1024px) {
    .m-foot {
      margin-top: var(--s-10);
    }
  }
  .m-writers,
  .m-undone {
    grid-column: 1 / -1;
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .m-writers {
      grid-column: 1 / span 5;
    }
    .m-undone {
      grid-column: 7 / span 6;
    }
  }
  .m-writers :global(.m-writers-text) {
    max-width: 28em;
    color: var(--fg-2);
  }
  .m-writers :global(.m-writers-named) {
    margin-top: var(--s-4);
  }
  .m-undone {
    margin: 0;
    padding-top: var(--s-5);
    border-top: 1px solid var(--line-ui);
  }
  .m-undone blockquote {
    margin: 0;
  }
  .m-undone :global(.m-undone-text) {
    max-width: 22em;
    font-size: var(--fs-lede);
    line-height: 1.6;
    color: var(--fg);
  }
  .m-undone :global(.m-undone-text:lang(en)) {
    line-height: 1.4;
  }
  .m-undone-cite {
    margin-top: var(--s-4);
    color: var(--fg-3);
    text-transform: none;
  }
  .m-undone-cite :global(.link) {
    color: var(--fg-2);
  }
  .m-undone-cite :global(code) {
    font-size: 1em;
  }

  /* ---- the verification rules: three plain statements, each after a short baseline hairline -------------- */
  .m-rules {
    margin-top: var(--s-8);
  }
  @media (min-width: 640px) {
    .m-rules {
      margin-top: var(--s-9);
    }
  }
  .m-rules :global(.m-rules-title) {
    margin-bottom: var(--s-5);
    color: var(--fg-3);
  }
  .m-rules-list {
    display: grid;
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-lede);
    line-height: 1.5;
    color: var(--fg);
  }
  .m-rules-list li {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
  }
  .m-rules-list li::before {
    content: '';
    flex: none;
    width: 16px;
    height: 1px;
    background: var(--line-ui);
    transform: translateY(-0.3em);
  }
  .m-rules-cite {
    margin-top: var(--s-5);
    color: var(--fg-3);
    text-transform: none;
  }
  .m-rules-cite :global(.link) {
    color: var(--fg-2);
  }

  @media (forced-colors: active) {
    .chain-line,
    .m-rules-list li::before {
      background: CanvasText;
    }
    .m-undone {
      border-top-color: CanvasText;
    }
  }
  @media print {
    .chain :global(:is([data-chain-line], [data-chain-term])) {
      opacity: 1 !important;
      transform: none !important;
    }
    .chain :global([data-chain-head]) {
      stroke-dashoffset: 0 !important;
    }
  }
</style>
