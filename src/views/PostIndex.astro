---
// The index of /articles/ or /views/ (owner decision 2026-10-07) in one locale; src/pages/[en/]<section>/index.astro
// are thin wrappers around this view.
//
//   header   label chip · h1 (文章 / 觀點, display face) · intro (articles: "not his personal views")
//   list     newest first; each item: label · date, the title (h2, the link), the description
//   empty    while the section has no published post in this locale: a calm empty lane and a way home. The page
//            still builds (links never 404) but carries noindex and stays out of the sitemap, llms.txt and the nav.
//
// Head: CollectionPage (articles: publisher = the site) or CollectionPage + Blog (views: author = the Person); the
// section card; the section's RSS feed. hreflang only when both locales have posts.
import Base from '../layouts/Base.astro';
import Section from '@ui/Section.astro';
import Display from '@ui/Display.astro';
import Arrow from '@ui/Arrow.astro';
import PostLabel from '../components/posts/PostLabel.astro';
import { localeOf, localePath, otherLocale, ts, type ContentPage } from '../components/chrome/i18n';
import { sectionCard } from '../components/chrome/og';
import { sectionPosts } from '@lib/content';
import { feedPath, hasPosts, isoDay, postPath, sectionPath, type PostSection } from '@lib/posts';
import { sectionLd, siteOrg } from '@lib/postld';

interface Props {
  section: PostSection;
}

const { section } = Astro.props;
const locale = localeOf(Astro);
const site = Astro.site ?? new URL('https://lijiabao.dev');
const all = await sectionPosts(section);
const list = all.filter((p) => p.locale === locale);
const empty = list.length === 0;
const other = otherLocale(locale);
const paired = !empty && hasPosts(all, section, other);
const path = sectionPath(section);
const title = ts(`meta.${section}.title`, locale);
const description = ts(`meta.${section}.desc`, locale);

const page: ContentPage = {
  kind: 'section',
  section,
  title,
  description,
  paths: paired ? { [locale]: path, [other]: path } : { [locale]: path },
  fallback: path,
  noindex: empty,
  ogImage: sectionCard(section, locale),
  ogAlt: ts(`meta.og.${section}`, locale),
  author: section === 'articles' ? String(siteOrg(site).name) : ts('site.name', locale),
  feed: feedPath(section),
  jsonld: sectionLd({ site, section, locale, name: title, description, posts: list }),
};
---
<Base page={page}>
  <Section id="posts" flush labelledby="posts--title">
    <div class="pi">
    <header class="pi-head">
      <PostLabel section={section} />
      <h1 id="posts--title" class="pi-title"><Display k={`posts.${section}.title`} size="l" /></h1>
      <p class="pi-intro t-lede">{ts(`posts.${section}.intro`, locale)}</p>
    </header>

    {
      empty ? (
        <div class="pi-empty">
          <div class="pi-lane" aria-hidden="true">
            <span class="pi-tick" />
            <span class="pi-tick pi-tick--end" />
          </div>
          <p class="pi-empty-text">{ts(`posts.${section}.empty`, locale)}</p>
          <a class="link pi-home" href={localePath(locale, '/')}>
            <Arrow dir="left" />{' '}{ts('nav.home', locale)}
          </a>
        </div>
      ) : (
        <Fragment>
          <ol class="pi-list" role="list" aria-label={ts(`posts.${section}.list`, locale)} data-copy-scope="post" data-md-plain>
            {list.map((p) => (
              <li class="pi-item" data-rise>
                <article class="pi-card grid" aria-labelledby={`pi--${p.slug}`}>
                  <p class="pi-meta lg-3">
                    <PostLabel section={section} as="span" mdAfter=" · " />
                    <time class="t-mono" datetime={isoDay(p.date)}>{isoDay(p.date)}</time>
                  </p>
                  <div class="pi-text lg-8 lg-start-5">
                    <h2 id={`pi--${p.slug}`} class="pi-name">
                      <a class="pi-link" href={localePath(locale, postPath(section, p.slug))}>{p.title}</a>
                    </h2>
                    <p class="pi-desc">{p.description}</p>
                  </div>
                </article>
              </li>
            ))}
          </ol>
          <p class="pi-feed" data-rise>
            <a class="link t-mono" href={localePath(locale, feedPath(section))} type="application/rss+xml">
              {ts('posts.feed', locale)}
            </a>
          </p>
        </Fragment>
      )
    }
    </div>
  </Section>
</Base>

<style>
  .pi {
    padding-top: calc(var(--header-h) + clamp(var(--s-7), 7vw, var(--s-10)));
    padding-bottom: var(--sec-pad);
  }
  .pi-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-5);
  }
  .pi-title {
    width: 100%;
    margin-top: var(--s-3);
    color: var(--fg);
  }
  .pi-intro {
    max-width: 30em;
    color: var(--fg-2);
  }

  /* ---- the list: one hairline row per post, newest first --------------------------------------------------- */
  .pi-list {
    margin-top: var(--s-9);
    border-bottom: 1px solid var(--line);
  }
  .pi-card {
    position: relative;
    row-gap: var(--s-3);
    padding-block: var(--s-6);
    border-top: 1px solid var(--line);
    transition: border-color var(--d-s) var(--ease-rise);
  }
  .pi-card:has(.pi-link:is(:hover, :focus-visible)) {
    border-top-color: var(--line-ui);
  }
  .pi-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    color: var(--fg-2);
  }
  @media (min-width: 1024px) {
    .pi-meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .pi-name {
    font-family: var(--ff-body);
    font-size: var(--fs-s);
    font-weight: 520;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .pi-name:lang(zh) {
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }
  /* the title is the link; its box covers the whole row (one tab stop, one target) */
  .pi-link {
    color: var(--fg);
    background: linear-gradient(currentColor, currentColor) no-repeat 100% 100% / 0 1px;
    transition: background-size var(--d-s) var(--ease-rise);
  }
  .pi-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .pi-link:is(:hover, :focus-visible) {
    background-position: 0 100%;
    background-size: 100% 1px;
  }
  .pi-link:focus-visible {
    outline: none;
  }
  .pi-link:focus-visible::after {
    outline: 2px solid var(--glim);
    outline-offset: -2px;
  }
  .pi-desc {
    max-width: var(--measure);
    margin-top: var(--s-3);
    color: var(--fg-2);
  }
  .pi-feed {
    margin-top: var(--s-6);
  }
  .pi-feed .link {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit);
    color: var(--fg-2);
  }

  /* ---- empty: the lane with nothing on it (no record, no light — the 404's motif, calmer) -------------------- */
  .pi-empty {
    display: grid;
    justify-items: start;
    gap: var(--s-5);
    margin-top: var(--s-9);
  }
  .pi-lane {
    position: relative;
    justify-self: stretch;
    height: 1px;
    background: var(--line);
  }
  .pi-tick {
    position: absolute;
    top: -4px;
    left: 0;
    width: 1px;
    height: 9px;
    background: var(--fg-3);
  }
  .pi-tick--end {
    left: auto;
    right: 0;
  }
  .pi-empty-text {
    font-size: var(--fs-lede);
    color: var(--fg-2);
  }
  .pi-home {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-height: var(--hit);
  }

  @media (forced-colors: active) {
    .pi-list,
    .pi-card,
    .pi-lane,
    .pi-tick {
      border-color: CanvasText;
    }
    .pi-lane,
    .pi-tick {
      background: CanvasText;
    }
  }
</style>
