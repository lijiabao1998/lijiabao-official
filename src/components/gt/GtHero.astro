---
// #gt-hero (§3, §4.3, §5.3) — label, h1, alias, tagline, lead, fact chips.
// The h1 carries transition:name="case-title-gt" (shared with the home work-row title: it arrives by view
// transition). On a direct load motion/sections/gt-hero.ts runs one baseline scan under the title, and each
// character gains weight as the head passes it (light comes from the left); the chips settle.
// The baseline hairline is the site's motif: the line every glyph sits on.
import Section from '@ui/Section.astro';
import Display from '@ui/Display.astro';
import T from '@ui/T.astro';
import { localeOf, tl } from '../chrome/i18n';

const locale = localeOf(Astro);
const chips = tl('gt.chips', locale);
---
<Section id="gt-hero" motion="gt-hero" label="gt.label" labelledby="gt-hero-title">
  <div class="gh">
    <h1 id="gt-hero-title" class="gh-title" transition:name="case-title-gt" data-gh-title>
      <Display k="gt.title" size="l" />
    </h1>
    <div class="gh-base" aria-hidden="true">
      <span class="gh-line" data-gh-line></span>
      <span class="gh-dot" data-gh-dot></span>
    </div>
    <T k="gt.alias" as="p" class="gh-alias t-label" />

    <div class="gh-body">
      <Display k="gt.tagline" as="p" size="s" class="gh-tagline" />
      <div class="gh-copy">
        <T k="gt.lead" as="p" class="gh-lead t-lede" />
        <ul class="gh-chips" role="list">
          {chips.map((c) => <li class="gh-chip" data-gh-chip>{c}</li>)}
        </ul>
      </div>
    </div>
  </div>
</Section>

<style>
  .gh {
    display: flex;
    flex-direction: column;
    min-height: clamp(420px, calc(78svh - var(--header-h)), 860px);
    justify-content: flex-end;
  }
  .gh-title {
    margin: 0;
    color: var(--fg);
  }
  /* the baseline: 1px under the title; the scan head rides it once on a direct load */
  .gh-base {
    position: relative;
    height: 1px;
    margin-top: var(--s-5);
  }
  .gh-line {
    position: absolute;
    inset: 0;
    background: var(--line-ui);
    transform-origin: 0 50%;
  }
  .gh-dot {
    position: absolute;
    left: -3px;
    top: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--glim);
    opacity: 0;
    pointer-events: none;
  }
  .gh-alias {
    margin-top: var(--s-3);
    color: var(--fg-2);
  }

  .gh-body {
    display: grid;
    gap: var(--s-6) var(--gap);
    margin-top: var(--s-9);
  }
  .gh-tagline {
    color: var(--fg);
  }
  .gh-lead {
    max-width: var(--measure);
    color: var(--fg-2);
  }
  .gh-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: var(--s-6) 0 0;
    padding: 0;
    list-style: none;
  }
  .gh-chip {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 4px 14px;
    border: 1px solid var(--line-ui);
    border-radius: 999px;
    font-family: var(--ff-mono);
    font-size: var(--fs-mono);
    font-weight: var(--w-mono);
    letter-spacing: 0.04em;
    line-height: 1.3;
    color: var(--fg);
    transform-origin: 0 50%;
  }

  @media (min-width: 1024px) {
    .gh-body {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }
    .gh-tagline {
      grid-column: 1 / span 5;
    }
    .gh-copy {
      grid-column: 7 / -1;
    }
  }

  /* JS tiers with full motion: the chips and the baseline start in their "before" state; motion.css' fail-open
     keyframes return them to rest after 2.5s if the motion core never runs. Text is never hidden. */
  :global(html[data-js][data-motion='full']:not([data-tier='static'])) .gh-chip {
    transform: scale(0.92);
    animation: lj-failopen 0s linear 2.5s forwards;
  }
  :global(html[data-js][data-motion='full']:not([data-tier='static'])) .gh-line {
    transform: scaleX(0);
    animation: lj-failopen 0s linear 2.5s forwards;
  }

  @media (forced-colors: active) {
    .gh-line {
      background: CanvasText;
    }
    .gh-chip {
      border-color: CanvasText;
    }
  }
</style>
