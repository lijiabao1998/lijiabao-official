{
  "name": "lijiabao-official",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/glyphs.mjs && node scripts/pack-commits.mjs && node scripts/sample-portrait.mjs",
    "build": "astro build",
    "postbuild": "node scripts/locale-404.mjs && node scripts/headers.mjs",
    "build:prod": "npm run check:types && npm run build && npm run check",
    "check": "npm run check:src && npm run check:dist",
    "check:types": "astro check",
    "check:src": "node scripts/check-dict.mjs && node scripts/check-copy.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "og": "node scripts/og.mjs",
    "test": "vitest run",
    "preview": "astro preview",
    "deploy:dry": "wrangler deploy --dry-run",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  },
  "allowScripts": {
    "esbuild": true
  },
  "private": true,
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.144.0"
  }
}
