---
// #work (S2 · §3 row 2, §4.2 Work, §5.3): the section label, the h2, and two <article> rows —
// GlimmerTown (mini CSS lattice, exactly 12,513 cells) and Frontier (mini 1 + 15 × 10 matrix). Each row title
// carries transition:name="case-title-gt|fr" so it flies into the case page's h1 (§5.5).
// Motion: motion/sections/work.ts (row reveals, hover weigh, magnetic arrows).
import Section from '@ui/Section.astro';
import Display from '@ui/Display.astro';
import WorkRow from './WorkRow.astro';
import { localeOf, localePath } from '../chrome/i18n';

const locale = localeOf(Astro);
---
<Section id="work" motion="work" label="work.label" labelledby="work-title">
  <Display k="work.title" as="h2" size="m" id="work-title" class="work-title" data-rise />
  <div class="work-rows">
    <WorkRow id="gt" href={localePath(locale, '/glimmertown/')} />
    <WorkRow id="fr" href={localePath(locale, '/frontier/')} />
  </div>
</Section>

<style>
  /* the display size lives on .display__set, so the measure is set there (in display ems) */
  :global(#work .work-title .display__set) {
    max-width: 13em;
  }
  /* h2 → first row: 48px on phones (plus the row's own 32px lead), 64px on tablets, the full 96px from 1024px */
  .work-rows {
    margin-top: var(--s-7);
  }
  @media (min-width: 640px) {
    .work-rows {
      margin-top: var(--s-8);
    }
  }
  @media (min-width: 1024px) {
    .work-rows {
      margin-top: var(--s-9);
    }
  }
</style>
