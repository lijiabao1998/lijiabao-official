---
// #hero (owner decision 2026-11-18: an introduction, not a slogan): the page's only h1 is the name; under it a
// plain introduction built from public facts, then three ways on — the work, GitHub, the articles (only when
// this locale has published articles) — and the size and date of the data behind the page.
//
// Text before light (site law 6): everything here is real HTML at rest weight and paints in the first frame
// (the h1 is the LCP). Nothing waits for WebGL, and nothing animates in: there is no opening sequence.
// No job title: the owner has not published one (scripts/lib/rules.mjs forbids one anywhere).
import Section from '@ui/Section.astro';
import T from '@ui/T.astro';
import Arrow from '@ui/Arrow.astro';
import { links } from '@data/links';
import { navSections } from '@lib/content';
import { localeOf, localePath, ts } from '../chrome/i18n';

const locale = localeOf(Astro);
const ext = ts('a11y.external', locale);
const articles = (await navSections(locale)).find((s) => s.section === 'articles');
---
<Section id="hero" labelledby="hero-title" flush class="hero">
  <div class="hero-in">
    <T k="hero.eyebrow" as="p" class="hero-eyebrow t-label" />
    <h1 id="hero-title" class="hero-h1"><T k="hero.name" /></h1>
    <T k="hero.intro" as="p" class="hero-intro t-lede" />

    <ul class="hero-cta" role="list">
      <li>
        <a class="hero-btn hero-btn--main" href="#work">
          <T k="hero.cta.work" /><Arrow dir="down" />
        </a>
      </li>
      <li>
        <a class="hero-btn" href={links.github} rel="me">
          <T k="hero.cta.github" /><Arrow dir="up-right" /><span class="sr-only">{ext}</span>
        </a>
      </li>
      {
        articles && (
          <li>
            <a class="hero-btn" href={localePath(locale, articles.path)}>
              <T k="hero.cta.articles" /><Arrow dir="right" />
            </a>
          </li>
        )
      }
    </ul>

    <p class="hero-meta t-label">
      <T k="hero.meta.repos" data-md-after=" · " /><span aria-hidden="true">{' · '}</span><T k="hero.meta.snapshot" />
    </p>
  </div>
</Section>

<style>
  .hero {
    padding-top: calc(var(--header-h) + clamp(48px, 12svh, 144px));
    padding-bottom: clamp(48px, 10svh, 120px);
  }
  .hero-in {
    max-width: 46rem;
  }

  .hero-eyebrow {
    color: var(--fg-3);
    margin-bottom: var(--s-4);
  }
  /* the name: display face (its glyphs are in the preloaded hero subset), a heading size, not a poster size */
  .hero-h1 {
    margin: 0;
    font-family: var(--ff-display);
    font-size: var(--fs-m);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--fg);
  }
  .hero-h1:lang(zh) {
    line-height: 1.2;
    letter-spacing: 0.04em;
  }
  .hero :global(.hero-intro) {
    max-width: 32em;
    margin-top: var(--s-5);
    color: var(--fg-2);
  }

  /* ---- three ways on: one filled, two outlined; 44px targets; the arrow is decoration ------------------ */
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin: var(--s-7) 0 0;
    padding: 0;
    list-style: none;
  }
  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: var(--hit);
    padding: 0 var(--s-5);
    border: 1px solid var(--line-ui);
    border-radius: 4px;
    color: var(--fg);
    font-size: var(--fs-body);
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color var(--d-s) var(--ease-rise),
      border-color var(--d-s) var(--ease-rise),
      color var(--d-s) var(--ease-rise);
  }
  .hero-btn:is(:hover, :focus-visible) {
    border-color: var(--fg);
    background: var(--bg-2);
  }
  .hero-btn--main {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--bg);
  }
  .hero-btn--main:is(:hover, :focus-visible) {
    border-color: var(--glim);
    background: var(--glim);
    color: var(--bg);
  }

  .hero-meta {
    margin-top: var(--s-7);
    color: var(--fg-3);
  }

  @media (forced-colors: active) {
    .hero-btn,
    .hero-btn--main {
      border-color: ButtonText;
      background: ButtonFace;
      color: ButtonText;
    }
  }
  @media print {
    .hero {
      padding-top: 0;
    }
  }
</style>
