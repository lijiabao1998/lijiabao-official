# Cloudflare Workers static assets headers (template).
# scripts/headers.mjs (postbuild) appends the Content-Security-Policy line to the `/*` block in dist/_headers,
# with sha256 hashes of every inline script found in dist (head boot + ClientRouter).

/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/gl/*
  Cache-Control: public, max-age=31536000, immutable

# Text for language models (scripts/llms.mjs): UTF-8 so Chinese never arrives as mojibake
/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8

/index.md
  Content-Type: text/markdown; charset=utf-8

/en/index.md
  Content-Type: text/markdown; charset=utf-8

/glimmertown/index.md
  Content-Type: text/markdown; charset=utf-8

/en/glimmertown/index.md
  Content-Type: text/markdown; charset=utf-8

/frontier/index.md
  Content-Type: text/markdown; charset=utf-8

/en/frontier/index.md
  Content-Type: text/markdown; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8
